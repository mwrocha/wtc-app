<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="br.com.fiap.wtcconnecta">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_login"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_login"
        android:supportsRtl="true"
        android:theme="@style/Theme.WTCConnecta"
        android:usesCleartextTraffic="true">

        <service
            android:name=".service.WTCFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.WTCConnecta"
            android:launchMode="singleTop">

            <!-- Launcher normal -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link para abrir chat via notificação push -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="wtcconnecta"
                    android:host="chat" />
            </intent-filter>

        </activity>
    </application>

</manifest>